[Unit]
Description=Aimee workflow control plane
After=aimee-server.service
Requires=aimee-server.service
PartOf=aimee.slice

[Service]
Type=simple
Slice=aimee.slice
Environment=AIMEE_HOME=%h/.config/aimee
ExecStart=%h/.local/bin/aimee-wfe --home %h/.config/aimee --socket %h/.config/aimee/aimee-wfe-http.sock --config %h/.config/aimee/aimee.yaml --workflow-dir %h/.config/aimee/workflows --forge-service-socket %h/.config/aimee/aimee-http.sock --module-bus-socket %h/.config/aimee/server-module-bus.sock
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal
MemoryHigh=2G
MemoryMax=4G
TasksMax=256
LimitNOFILE=65536

[Install]
WantedBy=default.target
